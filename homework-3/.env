# === PostgreSQL Booking ===
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=booking_secret
BOOKING_DB_NAME=booking_db
BOOKING_DB_PORT=5433

# === PostgreSQL Flight ===
FLIGHT_DB_USER=flight_user
FLIGHT_DB_PASSWORD=flight_secret
FLIGHT_DB_NAME=flight_db
FLIGHT_DB_PORT=5434

# === Redis Sentinel ===
REDIS_MASTER_PORT=6379
REDIS_REPLICA_PORT=6380
REDIS_SENTINEL_PORT=26379
REDIS_SENTINEL_QUORUM=1
REDIS_SENTINEL_MASTER_NAME=mymaster

# === Application Ports ===
BOOKING_SERVICE_PORT=8001
FLIGHT_SERVICE_GRPC_PORT=50051

# === Auth ===
GRPC_AUTH_KEY=super-secret-api-key-for-homework